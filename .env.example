# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
LOG_URL=https://your-log-url.example.com

# AI Credentials (Provide at least one)
AIPIPE_TOKEN=your_aipipe_token_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional Model Overrides
# AIPIPE_MODEL=gpt-5-mini
# GEMINI_MODEL=gemini-flash-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Optional Keep-Alive Pinger (prevents Render free tier from sleeping)
# PING_URL=https://your-app-name.onrender.com
# PING_INTERVAL=600
